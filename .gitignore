cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Build output
dist/
coverage/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
EOF
